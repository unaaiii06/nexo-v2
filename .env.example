# Copia este archivo como .env.local y rellénalo (npm run supabase:setup lo hace por ti).
# Son valores PÚBLICOS: la clave anon/publishable está pensada para ir dentro de la app;
# la seguridad la ponen las reglas (RLS) de la base de datos.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable
VITE_TELEGRAM_BOT=NombreDeTuBot
